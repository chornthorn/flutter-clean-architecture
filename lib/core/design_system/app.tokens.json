        "lg": { "$type": "number", "$value": 40 }
      }
    },
    "typography": {
      "display": {
        "regular": {
          "$type": "typography",
          "$value": {
            "fontSize": 32,
            "fontWeight": 400,
            "height": 1.2,
            "fontFamily": "$font.family.primary",
            "color": "$color.foreground.primary"
          }
        },
        "semiBold": {
